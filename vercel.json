{
  "builds": [
    {
      "src": "school_management/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "school_management/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/health/database-heartbeat/",
      "schedule": "0 3 * * *"
    }
  ]
}
